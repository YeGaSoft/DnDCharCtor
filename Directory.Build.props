<Project>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	  
	  
  </PropertyGroup>
	<PropertyGroup>
		<AnalysisMode>Recommended</AnalysisMode>
		
		<NoWarn>
			$(NoWarn);
			CS7035, <!-- The specified version string '0.x.*' does not conform to the recommended format - major.minor.build.revision -->
			CA1805 <!-- Do not initialize unnecessarily (with default value) -->
		</NoWarn>
	</PropertyGroup>

</Project>