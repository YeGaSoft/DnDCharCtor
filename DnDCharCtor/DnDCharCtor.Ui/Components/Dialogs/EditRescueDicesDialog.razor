@implements IDialogContentComponent<EditDialogParameter<RescueDicesViewModel>>

<EditDialogBase Content="@Content">
    <div class="rescue-dice-grid">
        <div class="rescue-dice-item">
            <FluentCheckbox @bind-Value="Content.ViewModel.Strength" />
            <strong>@StringResources.Character_Strength:</strong> @StatsVM.GetStatWithTrainingBonus(nameof(Properties.Strength))
        </div>
        <div class="rescue-dice-item">
            <FluentCheckbox @bind-Value="Content.ViewModel.Skillfulness" />
            <strong>@StringResources.Character_Skillfulness:</strong> @StatsVM.GetStatWithTrainingBonus(nameof(Properties.Skillfulness))
        </div>
        <div class="rescue-dice-item">
            <FluentCheckbox @bind-Value="Content.ViewModel.Constitution" />
            <strong>@StringResources.Character_Constitution:</strong> @StatsVM.GetStatWithTrainingBonus(nameof(Properties.Constitution))
        </div>
        <div class="rescue-dice-item">
            <FluentCheckbox @bind-Value="Content.ViewModel.Intelligence" />
            <strong>@StringResources.Character_Intelligence:</strong> @StatsVM.GetStatWithTrainingBonus(nameof(Properties.Intelligence))
        </div>
        <div class="rescue-dice-item">
            <FluentCheckbox @bind-Value="Content.ViewModel.Wisdom" />
            <strong>@StringResources.Character_Wisdom:</strong> @StatsVM.GetStatWithTrainingBonus(nameof(Properties.Wisdom))
        </div>
        <div class="rescue-dice-item">
            <FluentCheckbox @bind-Value="Content.ViewModel.Charisma" />
            <strong>@StringResources.Character_Charisma:</strong> @StatsVM.GetStatWithTrainingBonus(nameof(Properties.Charisma))
        </div>
    </div>
</EditDialogBase>

<style>
    .rescue-dice-grid {
        display: grid;
        gap: 1rem;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    }
    .rescue-dice-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
</style>
