@implements IDialogContentComponent<EditDialogParameter<RescueDicesViewModel>>

<EditDialogBase Content="@Content">
    <div class="rescue-dice-grid">
        <div class="rescue-dice-item">
            <FluentCheckbox @bind-Value="Content.ViewModel.Strength" Label="@StringResources.Character_Strength" />
            <ValidationMessage For="@(() => Content.ViewModel.Strength)" />
        </div>
        <div class="rescue-dice-item">
            <FluentCheckbox @bind-Value="Content.ViewModel.Skillfulness" Label="@StringResources.Character_Skillfulness" />
            <ValidationMessage For="@(() => Content.ViewModel.Skillfulness)" />
        </div>
        <div class="rescue-dice-item">
            <FluentCheckbox @bind-Value="Content.ViewModel.Constitution" Label="@StringResources.Character_Constitution" />
            <ValidationMessage For="@(() => Content.ViewModel.Constitution)" />
        </div>
        <div class="rescue-dice-item">
            <FluentCheckbox @bind-Value="Content.ViewModel.Intelligence" Label="@StringResources.Character_Intelligence" />
            <ValidationMessage For="@(() => Content.ViewModel.Intelligence)" />
        </div>
        <div class="rescue-dice-item">
            <FluentCheckbox @bind-Value="Content.ViewModel.Wisdom" Label="@StringResources.Character_Wisdom" />
            <ValidationMessage For="@(() => Content.ViewModel.Wisdom)" />
        </div>
        <div class="rescue-dice-item">
            <FluentCheckbox @bind-Value="Content.ViewModel.Charisma" Label="@StringResources.Character_Charisma" />
            <ValidationMessage For="@(() => Content.ViewModel.Charisma)" />
        </div>
    </div>
</EditDialogBase>

<style>
    .rescue-dice-grid {
        display: grid;
        gap: 1rem;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    }
    .rescue-dice-item {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
</style>
